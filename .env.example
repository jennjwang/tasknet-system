# Copy to .env and fill in. The tests need no keys; `tasknet process` and `tasknet build` call models.
# Variables already set in your shell win over this file.

# API keys (read by tasknet/env.py and handed to aggregate). LLM_API_KEY, when set, is used for every call;
# otherwise the provider's key.

# One key for everything. Only works if one endpoint serves every model (e.g. a proxy such as LiteLLM): set it below.
# LLM_API_KEY=
# LLM_BASE_URL=

# Or a key per provider. gpt-* models and embeddings use OpenAI (OPENAI_BASE_URL points them at another
# OpenAI-compatible endpoint). claude-* models need an OpenAI-compatible gateway that serves them;
# CLAUDE_BASE_URL is required for them (there is no default).
OPENAI_API_KEY=
# OPENAI_BASE_URL=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=

# Models, caps and batching are not set here: they are aggregate's configs.yml, overlaid by a configs.yml in
# the workspace (see README).

# Where results/, cache/ and .env live (default: this checkout, or the current directory when installed).
# WORKSPACE=

# The data package, if you have it: interviews are read from $DATA_DIR/interviews/<occupation>/.
# Unset, they are read from data/interviews/ (or pass --data-dir <folder of session JSONs>).
# Relative path settings here (DATA_DIR, REFERENCE_DATA_DIR, LLM_CACHE_DIR, HELDOUT_FROZEN) are taken from the
# workspace, so ../data is a folder beside it, wherever the command runs.
# DATA_DIR=../data

# interviewer/ (the Node app) reads interviewer/.env; see interviewer/.env.example.
