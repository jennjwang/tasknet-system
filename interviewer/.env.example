# Copy to interviewer/.env and fill in. Names only here — never commit a real value.

# ─── Required ─────────────────────────────────────────────────────────────────
# OpenAI: every model call with the default models, and audio transcription (/api/transcribe).
OPENAI_API_KEY=
# Or send the model calls through an OpenAI-compatible gateway instead (e.g. one serving Claude models);
# LLM_BASE_URL / LLM_API_KEY also work, as in the pipeline's .env. Transcription still uses OPENAI_API_KEY.
# CLAUDE_BASE_URL=
# CLAUDE_API_KEY=

# ─── Models (defaults shown) ──────────────────────────────────────────────────
# MODEL=gpt-5.4                         # task extraction, writing and gap-fill
# SMALL_MODEL=gpt-4o-mini               # small helper calls
# PLANNER_MODEL=gpt-5.4                 # the interviewer
# PLANNER_COUNT_MODEL=gpt-4o-mini       # the per-turn task extraction
# OCCUPATION_MODEL=gpt-5.4              # matching the participant to an O*NET occupation
# TRANSCRIBE_MODEL=whisper-1

# ─── Study setup ──────────────────────────────────────────────────────────────
# Your consent form's URL (read at build time). Unset, the welcome screen shows no consent link.
# VITE_CONSENT_URL=/my-consent-form.pdf
# Comma-separated O*NET-SOC codes to recruit. Unset = no occupation screener.
SCREENER_TARGET_SOC=
# How many attention checks a participant may fail (default: the code's own).
# ATTN_CHECK_MAX_FAILS=0
# Inferred tasks offered for confirmation after the interview (default 10).
# GAPFILL_COUNT=10
# Where interview sessions are saved (default interviewer/sessions/). Relative paths (here and CORPUS_PATH)
# are taken from interviewer/.
# SESSIONS_DIR=

# ─── Interviewer tuning (defaults shown) ──────────────────────────────────────
# PLANNER_MAX_TURNS=17                  # hard cap: 17
# PLANNER_MIN_TURNS=5
# PLANNER_REWRITE=1                     # 0 = don't rewrite stilted questions
# PLANNER_VARY=1                        # 0 = don't reshape questions that echo an earlier one
# OCCUPATION_TOP_N=3
# OCCUPATION_UNION_CAP=8

# ─── Validation survey (?phase=validation) ────────────────────────────────────
# Unset = responses are saved as files under validation/tools/out/; set to use Postgres.
# VALIDATION_DATABASE_URL=
# Access codes for the results view.
# VALIDATION_VIEWERS=
# Raters per task and the cohort size used to balance task subsets; occupations shown in full.
# COVERAGE_RATERS_PER_TASK=
# COVERAGE_COHORT_SIZE=
# COVERAGE_FULL_SOCS=
# COVERAGE_ASSIGN_TTL_HOURS=72
# Local testing only: caps how many tasks a rater sees. Leave unset when fielding.
# COVERAGE_MAX_TASKS=
# Where the survey's tools/ folder is (default validation/tools/; a relative path is taken from the repository
# root, for the server and the analysis tools alike).
# VALIDATION_DIR=

# ─── Retrieval grounding for the task generator (lib/retrieval.js), off by default ──
# On: the participant is matched to an occupation in a task corpus, whose statements are added to the
# generator prompt. Needs CORPUS_PATH: a JSON file of [{occupation, code?, statements: [...]}] (or
# {occupation: [statements]}); none ships with the app.
RETRIEVAL_ENABLED=false
# CORPUS_PATH=
# MATCH_MODEL=                          # default SMALL_MODEL
# RETRIEVAL_K=20                        # max statements added
# RETRIEVAL_TOP_OCCUPATIONS=1

# ─── Ports ────────────────────────────────────────────────────────────────────
# PORT=3001                             # API server
# API_PORT=3001                         # where the Vite dev server proxies /api
